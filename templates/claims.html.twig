<div style="max-width: 1100px; margin: 20px auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="margin: 0; color: #1351b4;">
            <span style="font-size: 24px;">🔍</span> {{ __('Diagnóstico de Claims Gov.br', 'govbrsso') }}
        </h2>
        <a href="{{ root_doc }}/plugins/govbrsso/front/config.form.php" style="background: #e2e8f0; color: #334155; padding: 6px 14px; border-radius: 4px; font-size: 13px; font-weight: 600; text-decoration: none; border: 1px solid #cbd5e1;">
            ⬅️ {{ __('Voltar à configuração', 'govbrsso') }}
        </a>
    </div>

    <div style="background: #e8f0fe; border: 1px solid #b3d4fc; border-radius: 6px; padding: 16px; margin-bottom: 20px; font-size: 14px; color: #1a3e72; line-height: 1.6;">
        <strong>{{ __('Como funciona:', 'govbrsso') }}</strong> {{ __('Cada vez que um usuário faz login via Gov.br, todas as informações (claims) recebidas do provedor são gravadas no log. Digite o CPF abaixo para buscar os registros de login e investigar problemas de criação duplicada de contas ou divergência de e-mails.', 'govbrsso') }}
    </div>

    <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 16px; margin-bottom: 20px; font-size: 14px; color: #92400e; line-height: 1.6;">
        <strong>{{ __('Nota sobre Retenção de Dados e Logs (Diagnóstico):', 'govbrsso') }}</strong> {{ __('O plugin grava as claims de identidade dos usuários (incluindo CPF, nome e e-mails de forma parcial ou total) nos arquivos de log estáticos do GLPI (files/_log/govbrsso.log) com o propósito exclusivo de diagnóstico e rastreabilidade técnica. O GLPI nativamente não aplica uma política automática de rotação e exclusão (expurgo) sobre plugins de terceiros. Portanto, recomenda-se configurar rotinas automatizadas no servidor (ex: logrotate ou tarefas programadas) para expurgar periodicamente estes logs e não reter dados pessoais sensíveis indefinidamente, garantindo conformidade com a LGPD.', 'govbrsso') }}
        
        <p style="margin: 15px 0 10px 0; font-size: 13px;">
            <strong>{{ __('Ação manual:', 'govbrsso') }}</strong> {{ __('Caso deseje apagar os logs de diagnóstico anteriores ao dia de hoje (arquivos .bak) agora mesmo, utilize o botão abaixo:', 'govbrsso') }}
        </p>
        <form method="post" action="{{ selfUrl }}" style="margin-top: 5px;" onsubmit="return confirm('{{ __('Tem certeza que quer apagar os logs anteriores ao dia de hoje (arquivos .bak)?', 'govbrsso') }}');">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <button type="submit" name="purge_bak_logs" value="1" style="background: #d97706; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 13px;">
                {{ __('Limpar Logs Antigos (.bak)', 'govbrsso') }}
            </button>
        </form>
    </div>

    <form id="debug-form" method="get" action="{{ selfUrl }}" style="display: flex; gap: 10px; margin-bottom: 25px; align-items: center;">
        <label for="cpf" style="font-weight: 600; color: #333; white-space: nowrap;">{{ __('Buscar por CPF:', 'govbrsso') }}</label>
        <input type="text" id="cpf" name="cpf" value="{{ filterCpfSafe }}" placeholder="000.000.000-00" 
               maxlength="14" inputmode="numeric"
               style="flex: 1; max-width: 300px; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; font-family: monospace;">
        <button type="submit" id="btn-buscar" style="padding: 8px 20px; background: #1351b4; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 14px;">
            {{ __('Buscar', 'govbrsso') }}
        </button>
    </form>

    <script>
    (function() {
        var cpfInput = document.getElementById('cpf');

        function maskCpf(v) {
            v = v.replace(/\D/g, '').substring(0, 11);
            if (v.length > 9) {
                v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
            } else if (v.length > 6) {
                v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
            } else if (v.length > 3) {
                v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
            }
            return v;
        }

        // Formata o valor inicial (caso venha da URL)
        cpfInput.value = maskCpf(cpfInput.value);

        cpfInput.addEventListener('input', function() {
            var pos = this.selectionStart;
            var oldLen = this.value.length;
            this.value = maskCpf(this.value);
            var newLen = this.value.length;
            pos += (newLen - oldLen);
            this.setSelectionRange(pos, pos);
        });

        cpfInput.addEventListener('keypress', function(e) {
            if (!/\d/.test(e.key) && e.key !== 'Enter') {
                e.preventDefault();
            }
        });

        var form = document.getElementById('debug-form');
        var btnBuscar = document.getElementById('btn-buscar');
        
        if (form && btnBuscar) {
            form.addEventListener('submit', function() {
                btnBuscar.disabled = true;
                btnBuscar.style.opacity = '0.7';
                btnBuscar.style.cursor = 'wait';
                btnBuscar.innerHTML = '{{ __('Carregando...', 'govbrsso') }}';
            });
        }
    })();
    </script>

{% if filterCpf == '' %}
    <div style="text-align: center; padding: 60px 20px; color: #999;"><span style="font-size: 48px; display: block; margin-bottom: 15px;">🔎</span><p style="font-size: 15px; margin: 0;">{{ __('Digite um CPF acima para consultar os dados recebidos do Gov.br.', 'govbrsso') }}</p></div>
{% elseif entries is empty %}
    <div style='text-align: center; padding: 40px; color: #888;'>{{ __('Nenhum registro encontrado para o CPF', 'govbrsso') }} <strong>{{ filterCpfSafe }}</strong>.</div>
{% else %}
    <p style='color: #666; font-size: 13px; margin-bottom: 15px;'><strong>{{ total }}</strong> {{ __('registro(s) encontrado(s) (mais recentes primeiro):', 'govbrsso') }}</p>

    {% for entry in entries %}
        <details style="margin-bottom: 10px; border: 1px solid #ddd; border-radius: 6px; overflow: hidden;">
            <summary style="padding: 12px 16px; background: #f8f9fa; cursor: pointer; font-size: 14px; display: flex; align-items: center; gap: 12px;">
                <span style="background: {{ entry.lvlColor }}; color: white; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">{{ entry.authTimeStr }}</span>
                <span style="font-weight: 600;">CPF: {{ entry.cpfFormatted }}</span>
                <span style="color: #888; font-size: 12px;">({{ entry.nome }})</span>
            </summary>
            <div style="padding: 12px;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                    <thead>
                        <tr style="background: #f1f3f5;">
                            <th style="padding: 8px 12px; text-align: left; border-bottom: 2px solid #dee2e6; width: 200px;">Claim</th>
                            <th style="padding: 8px 12px; text-align: left; border-bottom: 2px solid #dee2e6;">{{ __('Valor', 'govbrsso') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ entry.claimsRows|raw }}
                    </tbody>
                </table>
            </div>
        </details>
    {% endfor %}
{% endif %}

</div>
