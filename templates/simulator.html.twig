<div style="max-width: 1100px; margin: 20px auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="margin: 0; color: #1351b4;">
            <span style="font-size: 24px;">🧪</span> {{ __('Simulador de Criação de Contas', 'govbrsso') }}
        </h2>
        <a href="{{ root_doc }}/plugins/govbrsso/front/config.form.php" style="background: #e2e8f0; color: #334155; padding: 6px 14px; border-radius: 4px; font-size: 13px; font-weight: 600; text-decoration: none; border: 1px solid #cbd5e1;">
            ⬅️ {{ __('Voltar à configuração', 'govbrsso') }}
        </a>
    </div>

    <div style="background: #e8f0fe; border: 1px solid #b3d4fc; border-radius: 6px; padding: 16px; margin-bottom: 20px; font-size: 14px; color: #1a3e72; line-height: 1.6;">
        <strong>{{ __('Como funciona:', 'govbrsso') }}</strong> {{ __('Este simulador reproduz fielmente toda a cadeia de execução — desde a lógica do plugin até o comportamento interno do GLPI Core (User::post_addItem, Profile::getDefault, limpeza de perfis). Preencha os campos e veja passo a passo o que aconteceria em um login real.', 'govbrsso') }}
    </div>

    <form method="post" action="{{ selfUrl }}" style="background: #f8f9fa; border: 1px solid #ddd; padding: 20px; border-radius: 6px; margin-bottom: 25px;">
        
        <!-- CSRF Token nativo do GLPI -->
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 200px;">
                <label for="cpf" style="display: block; font-weight: 600; color: #333; margin-bottom: 8px;">{{ __('CPF Simulado:', 'govbrsso') }}</label>
                <input type="text" id="cpf" name="cpf" value="{{ cpf }}" placeholder="000.000.000-00" 
                       maxlength="14" inputmode="numeric"
                       style="width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; font-family: monospace;">
            </div>
            
            <div style="flex: 1; min-width: 200px;">
                <label for="email" style="display: block; font-weight: 600; color: #333; margin-bottom: 8px;">{{ __('E-mail Simulado:', 'govbrsso') }}</label>
                <input type="email" id="email" name="email" value="{{ email }}" placeholder="exemplo@dominio.com.br"
                       style="width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px;">
            </div>
            
            <div style="flex: 1; min-width: 200px;">
                <label for="nome" style="display: block; font-weight: 600; color: #333; margin-bottom: 8px;">{{ __('Nome Completo:', 'govbrsso') }}</label>
                <input type="text" id="nome" name="nome" value="{{ nome }}" placeholder="João Silva Santos"
                       style="width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px;">
            </div>
        </div>
        
        <div style="margin-top: 20px;">
            <button type="submit" style="padding: 10px 24px; background: #1351b4; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 14px;">
                {{ __('▶️ Simular Login', 'govbrsso') }}
            </button>
        </div>
    </form>

    <script>
    (function() {
        var cpfInput = document.getElementById('cpf');
        function maskCpf(v) {
            v = v.replace(/\D/g, '').substring(0, 11);
            if (v.length > 9) {
                v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
            } else if (v.length > 6) {
                v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
            } else if (v.length > 3) {
                v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
            }
            return v;
        }
        cpfInput.value = maskCpf(cpfInput.value);
        cpfInput.addEventListener('input', function() {
            var pos = this.selectionStart;
            var oldLen = this.value.length;
            this.value = maskCpf(this.value);
            var newLen = this.value.length;
            pos += (newLen - oldLen);
            this.setSelectionRange(pos, pos);
        });
        cpfInput.addEventListener('keypress', function(e) {
            if (!/\d/.test(e.key) && e.key !== 'Enter') {
                e.preventDefault();
            }
        });
    })();
    </script>

{% if result is not null %}
    
    {# === TIMELINE === #}
    {% if result.timeline is defined and result.timeline is not empty %}
        <div style="margin-bottom: 25px;">
            <h3 style="color: #1a3e72; margin-bottom: 15px; font-size: 18px;">
                📜 {{ __('Cadeia de Execução (Passo a Passo)', 'govbrsso') }}
            </h3>
            
            <div style="position: relative; padding-left: 30px;">
                {# Linha vertical da timeline #}
                <div style="position: absolute; left: 13px; top: 0; bottom: 0; width: 2px; background: #cbd5e1;"></div>
                
                {% for step in result.timeline %}
                    {% set isCore = step.source == 'GLPI Core' %}
                    {% set stepBg = isCore ? '#fef3c7' : '#eff6ff' %}
                    {% set stepBorder = isCore ? '#fcd34d' : '#bfdbfe' %}
                    {% set sourceBg = isCore ? '#f59e0b' : '#1351b4' %}
                    
                    <div style="position: relative; margin-bottom: 12px;">
                        {# Bolinha na timeline #}
                        <div style="position: absolute; left: -24px; top: 14px; width: 12px; height: 12px; background: {{ sourceBg }}; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 0 2px {{ sourceBg }};"></div>
                        
                        <div style="background: {{ stepBg }}; border: 1px solid {{ stepBorder }}; border-radius: 6px; padding: 12px 16px;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                                <span style="font-size: 16px;">{{ step.icon }}</span>
                                <strong style="font-size: 14px; color: #1e293b;">{{ step.step }}</strong>
                                <span style="background: {{ sourceBg }}; color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600;">{{ step.source }}</span>
                            </div>
                            <div style="font-size: 13px; color: #475569; line-height: 1.5;">{{ step.desc|raw }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
    
    {# === RESULTADO FINAL === #}
    {% set bgColor = '#f8f9fa' %}
    {% set borderColor = '#ddd' %}
    {% set textColor = '#333' %}
    {% set icon = 'ℹ️' %}
    
    {% if result.status == 'success' %}
        {% set bgColor = '#d4edda' %}
        {% set borderColor = '#c3e6cb' %}
        {% set textColor = '#155724' %}
        {% set icon = '✅' %}
    {% elseif result.status == 'error' %}
        {% set bgColor = '#f8d7da' %}
        {% set borderColor = '#f5c6cb' %}
        {% set textColor = '#721c24' %}
        {% set icon = '❌' %}
    {% elseif result.status == 'warning' %}
        {% set bgColor = '#fff3cd' %}
        {% set borderColor = '#ffeeba' %}
        {% set textColor = '#856404' %}
        {% set icon = '⚠️' %}
    {% endif %}

    <div style="background: {{ bgColor }}; border: 2px solid {{ borderColor }}; border-radius: 6px; padding: 20px; font-size: 15px; color: {{ textColor }};">
        <div style="font-weight: 700; font-size: 17px; margin-bottom: 10px;">{{ icon }} {{ __('Resultado Final', 'govbrsso') }}</div>
        <div style="margin-bottom: 10px;">{{ result.message }}</div>
        
        {% if result.details is not empty %}
            <table style="width: 100%; border-collapse: collapse; margin-top: 12px; background: rgba(255,255,255,0.7); border-radius: 4px; overflow: hidden;">
                {% for key, val in result.details %}
                    <tr style="border-bottom: 1px solid rgba(0,0,0,0.08);">
                        <td style="padding: 8px 12px; font-weight: 600; width: 200px; font-size: 13px;">{{ key }}</td>
                        <td style="padding: 8px 12px; font-size: 13px;">{{ val }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
    </div>
    
    {# Legenda #}
    <div style="display: flex; gap: 20px; margin-top: 15px; font-size: 12px; color: #64748b;">
        <div style="display: flex; align-items: center; gap: 6px;">
            <span style="display: inline-block; width: 10px; height: 10px; background: #1351b4; border-radius: 50%;"></span>
            Etapa do <strong>Plugin govbrsso</strong>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
            <span style="display: inline-block; width: 10px; height: 10px; background: #f59e0b; border-radius: 50%;"></span>
            Etapa do <strong>GLPI Core</strong> (User.php, Profile.php, Session.php)
        </div>
    </div>

{% endif %}

</div>
